# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Database (Drizzle ORM + drizzle-kit) --------------------------------------
# Matches the local server started by `npm run db:up`. Used by the app,
# `npm run db:migrate`, `npm run db:studio` and the other db:* scripts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexport"

# --- Site ----------------------------------------------------------------------
# Public URL of the marketing site (sitemap, robots.txt, social previews).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js -------------------------------------------------------------------
# Secret used to encrypt Auth.js cookies (OAuth state, nonce, CSRF).
# Generate one with:  openssl rand -base64 33
AUTH_SECRET=""
# Public URL of the app. Required in production (also enables Secure cookies).
AUTH_URL="http://localhost:3000"

# Google: https://console.cloud.google.com/apis/credentials
#   OAuth client type "Web application"
#   Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple: https://developer.apple.com/account/resources/identifiers
#   AUTH_APPLE_ID           the Services ID (e.g. com.example.nexport.web)
#   AUTH_APPLE_TEAM_ID      your 10-character Team ID
#   AUTH_APPLE_KEY_ID       the Key ID of a "Sign in with Apple" key
#   AUTH_APPLE_PRIVATE_KEY  contents of that .p8 key; newlines may be written as \n
#   Return URL: <AUTH_URL>/api/auth/callback/apple  (Apple requires HTTPS, no localhost)
# The client-secret JWT Apple requires is generated from the key automatically.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""

# Each sign-in provider is shown on /login only when all of its variables are set.
