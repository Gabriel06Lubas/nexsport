# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Database (Drizzle ORM + drizzle-kit) --------------------------------------
# Matches the local server started by `npm run db:up`. Used by the app,
# `npm run db:migrate`, `npm run db:studio` and the other db:* scripts.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexport"

# --- Site ----------------------------------------------------------------------
# Public URL of the marketing site (sitemap, robots.txt, social previews).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth.js -------------------------------------------------------------------
# Secret used to encrypt Auth.js cookies (OAuth state, nonce, CSRF) and to
# hash email codes. Generate one with:  openssl rand -base64 33
# Required in production. In development you can leave it empty: a random
# one is created once in .local/dev-auth-secret (git-ignored).
AUTH_SECRET=""
# Public URL of the app. Required in production (also enables Secure cookies).
AUTH_URL="http://localhost:3000"

# Google: https://console.cloud.google.com/apis/credentials
#   OAuth client type "Web application"
#   Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple: https://developer.apple.com/account/resources/identifiers
#   AUTH_APPLE_ID           the Services ID (e.g. com.example.nexport.web)
#   AUTH_APPLE_TEAM_ID      your 10-character Team ID
#   AUTH_APPLE_KEY_ID       the Key ID of a "Sign in with Apple" key
#   AUTH_APPLE_PRIVATE_KEY  contents of that .p8 key; newlines may be written as \n
#   Return URL: <AUTH_URL>/api/auth/callback/apple  (Apple requires HTTPS, no localhost)
# The client-secret JWT Apple requires is generated from the key automatically.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""

# Each sign-in provider is shown on /login only when all of its variables are set.

# --- Email (SMTP) --------------------------------------------------------------
# Sends the 6-digit codes for "Continue with email" and for confirming the
# email after a Google/Apple sign-up. Any SMTP provider works (Resend,
# Postmark, Amazon SES, Mailgun, Gmail…).
# Leave SMTP_HOST empty in development to print emails (and codes) in the
# terminal running `npm run dev` instead. In production it is required.
SMTP_HOST=""
# 587 = STARTTLS (default), 465 = implicit TLS (then set SMTP_SECURE="true")
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender shown to users; must be an address/domain your provider lets you send from.
EMAIL_FROM="nexport <no-reply@example.com>"

# --- Stripe (optional) ------------------------------------------------------------
# Without keys the app runs: courts and seats are paid at the club and the
# payment screens say online payments are off. Use test-mode keys first
# (https://dashboard.stripe.com/test/apikeys). See docs/payments.md.
STRIPE_SECRET_KEY=""
# Publishable key for Stripe.js (the Payment Element). Not a secret.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret of the webhook endpoint <AUTH_URL>/api/webhooks/stripe. Subscribe it to:
#   payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled,
#   checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe` prints a whsec_… value.
STRIPE_WEBHOOK_SECRET=""
# Development/tests only (ignored in production): send API calls to stripe-mock or another mock.
# STRIPE_API_BASE="http://127.0.0.1:12111"
