{
  "name": "nexport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "node e2e/auth.e2e.mjs",
    "test:e2e:admin": "node e2e/admin.e2e.mjs",
    "test:e2e:club": "node e2e/club.e2e.mjs",
